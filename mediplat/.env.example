# =============================================================================
# MediPlat — 환경변수 템플릿
# =============================================================================
# 이 파일은 "키 목록"이다. 실제 값은 절대 커밋하지 않는다.
#
#   로컬 실행 : 리포지토리 루트의 .env.local 을 쓴다(scripts/local-up.sh 가 source).
#   서버 실행 : systemd EnvironmentFile 로 주입한다. 파일 권한은 600.
#               예) /etc/default/mediplat-next
#
# properties 파일에서 평문 기본값을 제거했으므로, [필수] 항목이 비어 있으면
# 애플리케이션이 기동 단계에서 실패한다. 이는 의도된 동작이다(fail fast).
# -----------------------------------------------------------------------------

# ── 런타임 환경 ─────────────────────────────────────────────────────────────
# LOCAL | DEV | PROD.
# 미설정 시 spring.profiles.active 로 추론하고, 그것도 없으면 LOCAL 로 간주한다.
# DEV/PROD 에서는 서비스 base URL 에 localhost 를 쓸 수 없다(등록이 skip 된다).
PLATFORM_RUNTIME_ENV=
MEDIPLAT_PORT=

# ── DB [필수] ───────────────────────────────────────────────────────────────
# MediPlat 자체 스토어(mp_* 테이블). csm 과 동일 DB·동일 계정을 공유한다.
# MEDIPLAT_DATASOURCE_* 가 없으면 SPRING_DATASOURCE_* 로 폴백한다.
MEDIPLAT_DATASOURCE_URL=
MEDIPLAT_DATASOURCE_USERNAME=
MEDIPLAT_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ── CounselMan 조회용 보조 DataSource (선택) ────────────────────────────────
# 미설정 시 위 spring.datasource.* 값을 그대로 재사용한다.
PLATFORM_COUNSELMAN_DATASOURCE_URL=
PLATFORM_COUNSELMAN_DATASOURCE_USERNAME=
PLATFORM_COUNSELMAN_DATASOURCE_PASSWORD=
PLATFORM_COUNSELMAN_DATASOURCE_DRIVER_CLASS_NAME=

# ── CounselMan 계정 복호화 키 [필수] ────────────────────────────────────────
# AES-128, 16자 이상. csm 의 LOGIN_AES_KEY 와 동일해야 한다.
# PLATFORM_COUNSELMAN_LOGIN_AES_KEY 미설정 시 LOGIN_AES_KEY 로 폴백한다.
PLATFORM_COUNSELMAN_LOGIN_AES_KEY=
LOGIN_AES_KEY=

# ── SSO 공유 시크릿 [필수] ──────────────────────────────────────────────────
# 발급 측(mediplat)이 서명하고 csm / cancer-treatment / ResvHub 가 검증한다.
# 전 서비스가 동일 값이어야 하며, 무중단 교체 수단이 없다(점검창 필요).
COUNSELMAN_MEDIPLAT_SSO_SHARED_SECRET=
# 선택 — 발급 토큰 유효기간(초). 기본 60. 값을 키우지 말 것.
COUNSELMAN_MEDIPLAT_SSO_EXPIRE_SECONDS=

# ── 플랫폼 관리자 부트스트랩 [필수] ─────────────────────────────────────────
# mediplat 은 기동 시마다 이 계정을 생성/갱신한다. 비어 있으면 기동에 실패한다.
PLATFORM_ADMIN_PASSWORD=
# 선택
PLATFORM_ADMIN_INST_CODE=
PLATFORM_ADMIN_INST_NAME=
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_NAME=

# ── 연동 서비스 base URL ────────────────────────────────────────────────────
# DEV/PROD 에서는 localhost 를 쓸 수 없다. 실제 외부 도메인을 넣을 것.
COUNSELMAN_BASE_URL=
CANCER_TREATMENT_BASE_URL=

# ── 차량운행관리(fleet) (선택) ──────────────────────────────────────────────
FLEET_PHOTO_BASE_DIR=
FLEET_MAX_TRIP_KM=
FLEET_DEVICE_REMEMBER_DAYS=
FLEET_DEVICE_COOKIE_SECURE=

# ── 뉴스레터 AI (선택) ──────────────────────────────────────────────────────
MEDIPLAT_NEWSLETTER_AI_ENABLED=
OPENAI_API_KEY=
MEDIPLAT_NEWSLETTER_AI_MODEL=
MEDIPLAT_NEWSLETTER_AI_CACHE_HOURS=

# ── 점검 페이지 (선택) ──────────────────────────────────────────────────────
MAINTENANCE_FILE_PATH=
