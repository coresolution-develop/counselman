# =============================================================================
# cancer-treatment (암센터 치료스케줄) — 환경변수 템플릿
# =============================================================================
# 이 파일은 "키 목록"이다. 실제 값은 절대 커밋하지 않는다.
#
#   로컬 실행 : 리포지토리 루트의 .env.local 을 쓴다(scripts/local-up.sh 가 source).
#   서버 실행 : systemd EnvironmentFile 로 주입한다. 파일 권한은 600.
#               유닛 이름은 환경마다 다르다 — dev `cancer-treatment`,
#               prod `cancer-treatment-next`.
#               실제 경로는 `systemctl show <unit> -p EnvironmentFiles` 로 확인할 것.
#
# properties 파일에서 평문 기본값을 제거했으므로, [필수] 항목이 비어 있으면
# 애플리케이션이 기동 단계에서 실패한다. 이는 의도된 동작이다(fail fast).
# -----------------------------------------------------------------------------

# ── 서버 ────────────────────────────────────────────────────────────────────
CANCER_TREATMENT_PORT=

# ── SSO 공유 시크릿 [필수] ──────────────────────────────────────────────────
# ⚠️ csm / mediplat / ResvHub 와 "동일한 환경변수, 동일한 값"을 쓴다.
#    한 앱만 갱신하면 그 앱의 SSO 진입이 즉시 깨진다. 교체는 전 앱 동시에.
COUNSELMAN_MEDIPLAT_SSO_SHARED_SECRET=
# 선택 — 기본 60초
CANCER_TREATMENT_SSO_ALLOWED_CLOCK_SKEW_SECONDS=
# 선택 — SSO 실패 시 되돌아갈 포털 주소
CANCER_TREATMENT_MEDIPLAT_PORTAL_URL=

# ── DB ──────────────────────────────────────────────────────────────────────
# ⚠️ 미설정 시 H2 인메모리로 조용히 폴백한다(기동은 성공하지만 데이터가 휘발된다).
#    운영/개발 환경에서는 반드시 명시할 것.
#    CANCER_TREATMENT_DATASOURCE_* 가 없으면 SPRING_DATASOURCE_* 로 폴백한다.
CANCER_TREATMENT_DATASOURCE_URL=
CANCER_TREATMENT_DATASOURCE_USERNAME=
CANCER_TREATMENT_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 스키마 초기화 모드. 운영은 never 권장(기본값 embedded 는 H2 전용 동작이다).
CANCER_TREATMENT_SQL_INIT_MODE=
