# =============================================================================
# sms — 환경변수 템플릿
# =============================================================================
# ⚠️ 이 앱은 현재 미사용이며 배포 대상이 아니다. 기동하지 말 것.
#    상세는 sms/README.md 참고. 포트 8084 는 ResvHub(별도 리포지토리)가 점유 중이다.
#
# 이 파일은 "키 목록"이다. 실제 값은 절대 커밋하지 않는다.
# properties 파일에서 평문 기본값을 제거했으므로, [필수] 항목이 비어 있으면
# 애플리케이션이 기동 단계에서 실패한다. 이는 의도된 동작이다(fail fast).
# -----------------------------------------------------------------------------

# ── 서버 ────────────────────────────────────────────────────────────────────
# 미설정 시 0(랜덤 포트)으로 뜬다. 8084 는 ResvHub 가 쓰므로 절대 지정하지 말 것.
SMS_PORT=

# ── DB [필수] ───────────────────────────────────────────────────────────────
# csm 과 동일 DB. SMS_DATASOURCE_* 가 없으면 SPRING_DATASOURCE_* 로 폴백한다.
SMS_DATASOURCE_URL=
SMS_DATASOURCE_USERNAME=
SMS_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ── SSO 공유 시크릿 [필수] ──────────────────────────────────────────────────
# MediPlat 포털이 서명한 진입 토큰 검증용. 전 서비스가 동일 값을 공유한다.
COUNSELMAN_MEDIPLAT_SSO_SHARED_SECRET=
SMS_SSO_ALLOWED_CLOCK_SKEW_SECONDS=
SMS_MEDIPLAT_PORTAL_URL=

# ── Bizppurio 문자 게이트웨이 ───────────────────────────────────────────────
# 미설정 시 토큰 발급을 skip 하고 발송 시점에 예외를 던진다.
BIZPPURIO_ACCOUNT=
BIZPPURIO_USERNAME=
BIZPPURIO_PASSWORD=
BIZPPURIO_TOKEN_URL=
BIZPPURIO_MESSAGE_URL=
BIZPPURIO_TOKEN_CHECK_MS=

# ── 기타 (선택) ─────────────────────────────────────────────────────────────
SMS_PLATFORM_ADMIN_INST=
