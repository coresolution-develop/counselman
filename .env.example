# =============================================================================
# CounselMan (csm) — 환경변수 템플릿
# =============================================================================
# 이 파일은 "키 목록"이다. 실제 값은 절대 커밋하지 않는다.
#
#   로컬 실행 : 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
#               scripts/local-up.sh 가 자동으로 source 한다.
#   서버 실행 : systemd EnvironmentFile 로 주입한다. 파일 권한은 600.
#               예) /etc/default/csm-next  (scripts/systemd/README.md 참고)
#
# properties 파일에서 평문 기본값을 제거했으므로, 아래 [필수] 항목이 비어 있으면
# 애플리케이션이 기동 단계에서 실패한다. 이는 의도된 동작이다(fail fast).
# -----------------------------------------------------------------------------

# ── 프로파일 ────────────────────────────────────────────────────────────────
# local | dev | prod
SPRING_PROFILES_ACTIVE=

# ── DB [필수] ───────────────────────────────────────────────────────────────
# 전 프로파일(local/dev/prod)에서 필수. csm·mediplat·ResvHub 가 같은 csdev 계정을 공유한다.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# 선택 — 미설정 시 com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_DRIVER_CLASS_NAME=

# local 프로파일에서 scripts/local-up.sh 가 위 3개를 조립할 때 쓰는 재료.
# SPRING_DATASOURCE_* 를 직접 넣으면 아래는 불필요하다.
DEV_DB_HOST=
DEV_DB_PORT=
DEV_DB_NAME=
DEV_DB_USERNAME=
DEV_DB_PASSWORD=

# ── 로그인 암복호화 키 [필수] ───────────────────────────────────────────────
# AES-128. 정확히 16자여야 한다. mediplat 의 PLATFORM_COUNSELMAN_LOGIN_AES_KEY 와 동일해야
# CounselMan 계정 연동 로그인이 동작한다.
LOGIN_AES_KEY=

# ── MediPlat SSO 공유 시크릿 [필수] ─────────────────────────────────────────
# csm / mediplat / cancer-treatment / ResvHub 가 동일 값을 공유한다.
# 하나만 바꾸면 전 서비스 SSO 가 깨진다. 교체 시 점검창 필요.
COUNSELMAN_MEDIPLAT_SSO_SHARED_SECRET=
# 선택 — 설정 시 COUNSELMAN_MEDIPLAT_SSO_SHARED_SECRET 보다 우선한다.
MEDIPLAT_SSO_SHARED_SECRET=
# 선택 — 기본 60초
MEDIPLAT_SSO_ALLOWED_CLOCK_SKEW_SECONDS=
# 선택 — SSO 토큰 유효기간 상한(초). 기본 300. 발급 측 기본값(60초)과는 별개다.
MEDIPLAT_SSO_MAX_TTL_SECONDS=

# ── 메일 [필수] ─────────────────────────────────────────────────────────────
# 비밀번호 재설정 링크 발송용. Gmail 앱 비밀번호.
SPRING_MAIL_PASSWORD=
# 선택
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=

# ── Kakao OAuth2 [필수] ─────────────────────────────────────────────────────
# 챗봇 사용자 로그인. client-id 는 공개 식별자지만 앱 단위로 다르므로 함께 주입한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── Bizppurio 문자 게이트웨이 ───────────────────────────────────────────────
# dev 프로파일에서 [필수]
BIZPPURIO_DEV_ACCOUNT=
BIZPPURIO_DEV_USERNAME=
BIZPPURIO_DEV_PASSWORD=
# prod 프로파일에서 [필수]
BIZPPURIO_PROD_ACCOUNT=
BIZPPURIO_PROD_USERNAME=
BIZPPURIO_PROD_PASSWORD=
# 선택 — 엔드포인트 override
BIZPPURIO_TOKEN_URL=
BIZPPURIO_MESSAGE_URL=
BIZPPURIO_TOKEN_CHECK_MS=
# 선택 — HTTP 타임아웃(ms). 기본 connect 5000 / read 10000
BIZPPURIO_CONNECT_TIMEOUT_MS=
BIZPPURIO_READ_TIMEOUT_MS=

# ── 플랫폼 관리자 부트스트랩 (선택) ─────────────────────────────────────────
# PLATFORM_ADMIN_BOOTSTRAP_ENABLED=true 로 켤 때만 PLATFORM_ADMIN_PASSWORD 가 필요하다.
# 비어 있으면 부트스트랩은 WARN 로그 후 skip 된다(기동은 정상).
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_SYNC_PASSWORD_ON_STARTUP=

# ── 외부 URL / 경로 (선택) ──────────────────────────────────────────────────
CSM_BASE_URL=
MEDIPLAT_PLATFORM_BASE_URL=
COUNSEL_AUDIO_BASE_DIR=
COUNSEL_FILE_BASE_DIR=

# ── 링크 허브 (선택) ────────────────────────────────────────────────────────
HUB_SIGNUP_CODE=
HUB_REMEMBER_DAYS=
HUB_REMEMBER_COOKIE_SECURE=

# ── 외부 AI / STT (선택) ────────────────────────────────────────────────────
OPENAI_API_KEY=
NCP_CLOVA_INVOKE_URL=
NCP_CLOVA_SECRET_KEY=
